#   cp .env.example .env
#
# 两份 compose 文件对 .env 的用法不同：
#   - docker-compose.yml：配置项直接写在 environment 中，.env 只用于覆盖 HOST_PORT
#   - docker-compose-ghcr.yml：配置项全部从 .env 读取，.env 必须填齐下面 4 个必填项
# .env 已在 .gitignore 中，令牌写在这里不会被提交。

# ---- 宿主机映射端口，仅 docker-compose.yml 使用 ----
HOST_PORT=8080

# ---- 以下 4 项仅 docker-compose-ghcr.yml 读取（必填） ----

# 微信测试号后台自定义的 Token
WECHAT_TOKEN=

# 允许处理消息的唯一发送者 OpenID
WECHAT_ALLOW_OPENID=

# Memos 实例基地址，不含 /api/v1 前缀
MEMOS_API_URL=https://memos.example.com

# Memos 访问令牌，即 Bearer 之后的字符串
MEMOS_ACCESS_TOKEN=
